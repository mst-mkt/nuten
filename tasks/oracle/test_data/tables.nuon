{
    plain: [[name, version]; [a, "1.0"] [b, "2.0"]]
    quoted_and_dotted_columns: [["c d", e.f, `g`]; [1 2 3]]
    empty_columns: [[]; []]
    typed_cells: [[when, size, took, span, bin, path];
        [2024-01-01 1kb 1sec 1..3 0x[ff] $.a]
        [2024-06-01T10:00:00+09:00 2mb 3day 4..<5 0b[1] $.b.c]
    ]
    nested: [[inner]; [[[a]; [1]]] [{a: 2}] [[3]]]
    trailing_comma: [[a]; [1], [2],]
    # a comment between rows
    commented: [[a]; # after the columns
        [1]
        # between rows
        [2]
    ]
}
