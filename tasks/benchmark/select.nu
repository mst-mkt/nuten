# Picks the corpus files the benchmark against the base measures, each by a rule rather than by hand.
# The measures come from the tokens nu flattens a file into, so they count what nu reads.

const OUTPUT = path self inputs.nuon

const HEADER = "# Generated by tasks/benchmark/select.nu from the corpus dev/flake.lock pins; do not edit.
# Regenerate after updating the corpus:
# nu tasks/benchmark/select.nu $env.NUTEN_CORPUS target/release/nuten | save -f tasks/benchmark/inputs.nuon
"

# Prints the picked inputs as NUON, with paths relative to the corpus.
def main [
    corpus: path # The corpus directory, as NUTEN_CORPUS names it
    nuten: path # The nuten binary, which must format each picked file
]: nothing -> string {
    let files = glob ($corpus | path join '**/*.nu')
    if ($files | is-empty) {
        print --stderr $"no .nu file under ($corpus)"
        exit 2
    }

    let picks = $files
        | par-each {|file| candidate $file $corpus $nuten }
        | compact
        | each {|file| { path: $file.path, ...($file.source | measure) } }
        | pick-inputs
    let unpicked = $picks | transpose rule path | where path == null | get rule
    if not ($unpicked | is-empty) {
        print --stderr $"no file for ($unpicked | str join ', ') under ($corpus)"
        exit 2
    }

    $picks | render $nuten
}

# The benchmark measures how nuten formats each pick, so a file it does not format cannot be one.
def candidate [file: path, corpus: path, nuten: path]: nothing -> oneof<record, nothing> {
    let source = open --raw $file
    if ($source | describe) == string and (nuten-formats $source $file $nuten) {
        { path: ($file | path relative-to $corpus), source: $source }
    }
}

# Without the path, nuten would take the config found from where this runs.
def nuten-formats [source: string, file: path, nuten: path]: nothing -> bool {
    ($source | ^$nuten format --stdin-filepath $file - | complete | get exit_code) == 0
}

def measure []: string -> record {
    let source = $in
    let tokens = ast --flatten $source

    {
        bytes: ($source | str length --utf-8-bytes)
        interpolations: (
            $tokens | where shape == shape_string_interpolation and content starts-with '$' | length
        )
        pipes: ($tokens | where shape == shape_pipe | length)
    }
}

def pick-inputs []: list<record> -> record {
    let files = $in

    {
        largest: ($files | most bytes)
        most_interpolations: ($files | most interpolations)
        most_pipes: ($files | most pipes)
        largest_in_stdlib: ($files | where path starts-with 'nu-std/' | most bytes)
        directory: 'nu-std'
    }
}

# Ties go to the path first in order, so the pick does not depend on the order glob walks in.
def most [measure: cell-path]: list<record> -> oneof<string, nothing> {
    sort-by path
    | sort-by --custom {|a, b| ($a | get $measure) > ($b | get $measure) }
    | get --optional 0.path
}

def render [nuten: path]: record -> string {
    to nuon
    | $"($HEADER)($in)"
    | ^$nuten format --stdin-filepath $OUTPUT -
}
