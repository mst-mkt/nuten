const OUTPUT = path self ../inputs.nuon

const HEADER = "# Generated by tasks/benchmark/main.nu select from the corpus nix/dev/flake.lock pins; do not edit.
# Regenerate after updating the corpus:
# nu tasks/benchmark/main.nu select $env.NUTEN_CORPUS target/release/nuten | save -f tasks/benchmark/inputs.nuon
"

export def picks [corpus: path, nuten: path]: nothing -> record {
    glob ($corpus | path join '**/*.nu')
    | par-each {|file| candidate $file $corpus $nuten }
    | compact
    | each {|file| { path: $file.path, ...($file.source | measure) } }
    | pick-inputs
}

def candidate [file: path, corpus: path, nuten: path]: nothing -> oneof<record, nothing> {
    let source = open --raw $file
    if ($source | describe) == string and (nuten-formats $source $file $nuten) {
        { path: ($file | path relative-to $corpus), source: $source }
    }
}

def nuten-formats [source: string, file: path, nuten: path]: nothing -> bool {
    ($source | ^$nuten format --stdin-filepath $file - | complete | get exit_code) == 0
}

def measure []: string -> record {
    let source = $in
    let tokens = ast --flatten $source

    {
        bytes: ($source | str length --utf-8-bytes)
        interpolations: (
            $tokens | where shape == shape_string_interpolation and content starts-with '$' | length
        )
        pipes: ($tokens | where shape == shape_pipe | length)
    }
}

def pick-inputs []: list<record> -> record {
    let files = $in

    {
        largest: ($files | most bytes)
        most_interpolations: ($files | most interpolations)
        most_pipes: ($files | most pipes)
        largest_in_stdlib: ($files | where path starts-with 'nu-std/' | most bytes)
        directory: 'nu-std'
    }
}

def most [measure: cell-path]: list<record> -> oneof<string, nothing> {
    sort-by path
    | sort-by --custom {|a, b| ($a | get $measure) > ($b | get $measure) }
    | get --optional 0.path
}

export def render [nuten: path]: record -> string {
    to nuon
    | $"($HEADER)($in)"
    | ^$nuten format --stdin-filepath $OUTPUT -
}
