---
source: crates/nuten_config/tests/schema.rs
expression: schema()
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nuten",
  "description": "Settings of nuten, a formatter for Nushell.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Where an editor finds the JSON Schema; nuten does not read it.",
      "type": "string"
    },
    "line_width": {
      "description": "Columns a line may take before it breaks where it can.",
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "indent_style": {
      "description": "Whether to indent with spaces or with tabs.",
      "enum": ["space", "tab"]
    },
    "indent_width": {
      "description": "Columns per indent level, and per tab when indenting with tabs.",
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "line_ending": {
      "description": "What ends each line; line breaks inside a string, a bare word, or an `@example` block stay as written.",
      "enum": ["lf", "crlf"]
    },
    "commas": {
      "description": "Where a `,` goes among the items of lists, records, tables, parameters, and type parameters: nowhere, between items on one line, between items, or also after the last item when they break over lines.",
      "enum": ["none", "inline", "always", "trailing"]
    },
    "respect_gitignore": {
      "description": "Whether formatting a directory skips the files ignored by `.gitignore`, `.ignore`, the exclude file of the repository, or the global excludes file of git. The config file nearest the directory, or the one `--config` names, decides it for everything under the directory.",
      "type": "boolean"
    },
    "include": {
      "description": "Glob patterns of the files formatting a directory takes, in place of `*.nu`. A pattern without a `/` matches a file name at any depth; one with a `/` matches the path from the directory of the config file, or from the current directory for the config file `--config` names. A file named directly is formatted whether it matches or not.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "description": "Glob patterns of the files to leave alone, even when named directly, and of the directories whose files to leave alone. A pattern without a `/` matches a name at any depth; one with a `/` matches the path from the directory of the config file, or from the current directory for the config file `--config` names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "overrides": {
      "description": "Settings for some files, in records of the settings that may differ from file to file. `include` picks the files of a record and `exclude` leaves some of them out, with patterns that match as the top-level ones do. A later record wins over an earlier one where both pick a file.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "include": {
            "description": "Glob patterns of the files the record is for; they match as those of the top-level `include` do.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "description": "Glob patterns of the files, and of the directories whose files, the record is not for though `include` picks them; they match as those of the top-level `exclude` do.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "line_width": {
            "description": "Columns a line may take before it breaks where it can.",
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "indent_style": {
            "description": "Whether to indent with spaces or with tabs.",
            "enum": ["space", "tab"]
          },
          "indent_width": {
            "description": "Columns per indent level, and per tab when indenting with tabs.",
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "line_ending": {
            "description": "What ends each line; line breaks inside a string, a bare word, or an `@example` block stay as written.",
            "enum": ["lf", "crlf"]
          },
          "commas": {
            "description": "Where a `,` goes among the items of lists, records, tables, parameters, and type parameters: nowhere, between items on one line, between items, or also after the last item when they break over lines.",
            "enum": ["none", "inline", "always", "trailing"]
          }
        },
        "required": ["include"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
