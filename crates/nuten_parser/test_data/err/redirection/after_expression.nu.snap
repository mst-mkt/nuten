Root@0..9
  Pipeline@0..8
    PipelineElement@0..8
      MathExpression@0..5
        Word@0..1 "1"
        Whitespace@1..2 " "
        Operator@2..3 "+"
        Whitespace@3..4 " "
        Word@4..5 "2"
      Whitespace@5..6 " "
      Redirection@6..8
        Error@6..8
