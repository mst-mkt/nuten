---
source: crates/nuten_parser/tests/parse.rs
input_file: crates/nuten_parser/test_data/err/lex_errors.nu
---
Root@0..12
  Pipeline@0..11
    Word@0..4 "echo"
    Whitespace@4..5 " "
    Error@5..7 "a)"
    Whitespace@7..8 " "
    Error@8..10 "r#"
    Word@10..11 "x"
  Newline@11..12 "\n"
error 6..7 ")": Lex(UnmatchedCloser)
error 8..10 "r#": Lex(MissingRawQuote)
