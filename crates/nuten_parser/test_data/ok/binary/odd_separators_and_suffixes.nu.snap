---
source: crates/nuten_parser/tests/parse.rs
input_file: crates/nuten_parser/test_data/ok/binary/odd_separators_and_suffixes.nu
---
Root@0..48
  Pipeline@0..47
    PipelineElement@0..47
      List@0..47
        LBracket@0..1 "["
        Word@1..10 "0x[ff;00]"
        Whitespace@10..11 " "
        Word@11..20 "0x[ff|00]"
        Whitespace@20..21 " "
        Word@21..27 "0X[ff]"
        Whitespace@27..28 " "
        Word@28..35 "0x[ff]a"
        Whitespace@35..36 " "
        Word@36..46 "0x[ff][00]"
        RBracket@46..47 "]"
  Newline@47..48 "\n"
