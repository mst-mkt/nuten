---
source: crates/nuten_parser/tests/parse.rs
input_file: crates/nuten_parser/test_data/ok/variable/in_variable_after_pipe.nu
---
Root@0..9
  Pipeline@0..8
    PipelineElement@0..2
      Call@0..2
        Word@0..2 "ls"
    Whitespace@2..3 " "
    Pipe@3..4 "|"
    Whitespace@4..5 " "
    PipelineElement@5..8
      Word@5..8 "$in"
  Newline@8..9 "\n"
