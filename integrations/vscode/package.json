{
  "name": "nuten-vscode",
  "displayName": "Nuten",
  "version": "0.0.0",
  "private": true,
  "description": "A formatter for Nushell. Robust, fast, and tiny.",
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "code-formatter",
    "formatter",
    "nu",
    "nushell"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mst-mkt/nuten",
    "directory": "integrations/vscode"
  },
  "publisher": "mst-mkt",
  "files": [
    "dist/extension.cjs",
    "icon.png",
    "LICENSE"
  ],
  "main": "./dist/extension.cjs",
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.91.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "nushell",
        "aliases": [
          "Nushell",
          "nu"
        ],
        "extensions": [
          ".nu"
        ]
      },
      {
        "id": "nuon",
        "aliases": [
          "NUON",
          "nuon"
        ],
        "extensions": [
          ".nuon"
        ]
      }
    ],
    "configuration": {
      "title": "Nuten",
      "properties": {
        "nuten.path": {
          "type": "string",
          "default": "nuten",
          "scope": "machine-overridable",
          "description": "Path to the nuten executable."
        },
        "nuten.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the communication between VS Code and the Nuten language server."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:nuon",
    "onLanguage:nushell"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The workspace setting of `nuten.path` is ignored in untrusted workspaces.",
      "restrictedConfigurations": [
        "nuten.path"
      ]
    }
  }
}
